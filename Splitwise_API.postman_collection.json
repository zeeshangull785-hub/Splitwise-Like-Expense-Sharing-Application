						}
					}
				},
				{
					"name": "Record Settlement Payment",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{auth_token}}" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"paid_to\": \"{{creditor_user_id}}\",\n    \"amount\": 1000,\n    \"note\": \"Settlement via Bank Transfer\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/groups/{{group_id}}/settlements",
							"host": ["{{base_url}}"],
							"path": ["api", "groups", "{{group_id}}", "settlements"]
						}
					}
				}
			]
		}
	],
